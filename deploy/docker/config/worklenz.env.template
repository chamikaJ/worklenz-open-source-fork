# ============================================
# WORKLENZ PRODUCTION CONFIGURATION
# ============================================
# This file contains all environment variables for Worklenz
# Copy this to worklenz.env and update values
# NEVER commit worklenz.env to version control!

# ============================================
# CORE CONFIGURATION
# ============================================
WORKLENZ_VERSION=1.5.0
NODE_ENV=production
INSTALLATION_MODE=express  # express, standard, enterprise

# Domain & URLs
DOMAIN=localhost
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
SOCKET_URL=ws://localhost
USE_SSL=false

# Ports
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=3000
FRONTEND_PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_TYPE=embedded  # embedded, external
DB_HOST=postgres
DB_PORT=5432
DB_NAME=worklenz_db
DB_USER=worklenz
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_MAX_CONNECTIONS=50
DB_SSL_MODE=prefer

# External Database (for standard/enterprise mode)
# Uncomment and configure if using external database
# DB_HOST=your-db-endpoint.example.com
# DB_PORT=5432
# DB_SSL_MODE=require
# DB_USER=worklenz
# DB_PASSWORD=your_external_db_password

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_TYPE=embedded  # embedded, external
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_DB=0
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru

# External Redis (for standard/enterprise mode)
# Uncomment and configure if using external Redis
# REDIS_HOST=your-redis-endpoint.example.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_external_redis_password
# REDIS_TLS=true

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_PROVIDER=minio  # minio, s3, azure

# MinIO (Embedded - Express Mode)
MINIO_TYPE=embedded  # embedded, external
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_HERE
MINIO_BUCKET=worklenz-bucket
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# S3 Configuration (for S3 or S3-Compatible storage)
S3_URL=http://minio:9000/worklenz-bucket
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=worklenz-bucket
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD_HERE
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

# External S3-Compatible (Standard/Enterprise Mode)
# Uncomment and configure if using external S3-compatible storage
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.amazonaws.com  # or your S3-compatible endpoint
# S3_REGION=us-east-1
# S3_BUCKET=worklenz-files
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_FORCE_PATH_STYLE=false
# S3_USE_SSL=true
# S3_URL=https://your-bucket.s3.region.amazonaws.com

# Azure Blob Storage (Alternative)
# Uncomment and configure if using Azure Blob Storage
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=your_account_name
# AZURE_STORAGE_CONTAINER=worklenz-files
# AZURE_STORAGE_ACCOUNT_KEY=your_account_key
# AZURE_STORAGE_URL=https://your_account.blob.core.windows.net
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
SESSION_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_STRING_FOR_SESSION_SECRET_HERE
SESSION_NAME=worklenz.sid
SESSION_COOKIE_SECURE=false  # Set to true when using HTTPS
SESSION_COOKIE_MAX_AGE=86400000  # 24 hours in milliseconds

COOKIE_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_STRING_FOR_COOKIE_SECRET_HERE
JWT_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_STRING_FOR_JWT_SECRET_HERE_XXX
CSRF_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_STRING_FOR_CSRF_SECRET_HERE_XXX

# Trust proxy (set to true if behind Nginx/load balancer)
TRUST_PROXY=true

# Security Headers
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# Google OAuth (Optional)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp  # smtp, ses

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true  # true for 465, false for other ports
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@worklenz.example.com
SMTP_FROM_NAME=Worklenz

# AWS SES (Alternative to SMTP)
# Uncomment if using AWS SES
# EMAIL_PROVIDER=ses
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your_ses_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key
# AWS_REGION=us-east-1

# Email Addresses
CONTACT_US_EMAIL=support@example.com
ADMIN_EMAIL=admin@example.com

# ============================================
# FEATURES & WORKERS
# ============================================
# Enable background workers
ENABLE_WORKERS=true

# Enable email cron jobs (daily digests, notifications)
ENABLE_EMAIL_CRONJOBS=true

# Enable recurring task automation
ENABLE_RECURRING_JOBS=true
RECURRING_JOBS_INTERVAL="0 11 */1 * 1-5"  # 11 AM, every day, Mon-Fri

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info  # error, warn, info, debug
ENABLE_ACCESS_LOGS=true
ENABLE_METRICS=false  # Prometheus metrics (future feature)

# PostgreSQL Native
USE_PG_NATIVE=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # requests per window

# ============================================
# CORS CONFIGURATION
# ============================================
# CORS Origins (* allows all, or specify comma-separated domains)
CORS_ORIGIN=*
SERVER_CORS=*
SOCKET_IO_CORS=http://localhost

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=false  # GPG encryption for backups
BACKUP_CLOUD_SYNC=false  # Sync backups to cloud storage

# Cloud Backup (if BACKUP_CLOUD_SYNC=true)
# BACKUP_CLOUD_PROVIDER=s3  # s3, azure, gcs
# BACKUP_CLOUD_BUCKET=worklenz-backups
# BACKUP_CLOUD_REGION=us-east-1
# BACKUP_CLOUD_ACCESS_KEY=
# BACKUP_CLOUD_SECRET_KEY=

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Initial admin account (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================
# Google reCAPTCHA
GOOGLE_CAPTCHA_ENABLED=false
GOOGLE_CAPTCHA_SECRET_KEY=
GOOGLE_CAPTCHA_PASS_SCORE=0.8

# Slack Notifications
SLACK_WEBHOOK=
SLACK_NOTIFICATIONS_ENABLED=false

# DirectPay (Payment Gateway - if applicable)
DP_STAGE=DEV
DP_URL=
DP_MERCHANT_ID=
DP_SECRET_KEY=
DP_API_KEY=

# ============================================
# CLI CONFIGURATION (Development Only)
# ============================================
ANGULAR_DIST_DIR=
ANGULAR_SRC_DIR=
BACKEND_PUBLIC_DIR=
BACKEND_VIEWS_DIR=
COMMIT_BUILD_IMMEDIATELY=false

# ============================================
# DEVELOPMENT/DEBUG SETTINGS
# ============================================
# Only use in development!
# DEBUG=false
# VERBOSE_LOGGING=false
# SKIP_MIGRATIONS=false
